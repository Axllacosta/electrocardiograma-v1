{
  "name": "cardio-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-env.mjs install",
    "predev": "node scripts/check-env.mjs dev",
    "dev": "vite",
    "start": "npm run dev",
    "prebuild": "node scripts/check-env.mjs build",
    "build": "tsc --noEmit && vite build",
    "prepreview": "node scripts/check-env.mjs preview",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "pretest": "node scripts/check-env.mjs test",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
